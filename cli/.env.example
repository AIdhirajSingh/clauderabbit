# ClaudeRabbit client configuration (all optional).
#
# The client posts to ${CLAUDE_RABBIT_SITE_URL}/api/scan with the signed-in
# cr_cli_ token saved by `clauderabbit login`. It holds no other credential.

# Site the client calls and links to. Override for a fork, a Vercel preview,
# or local dev against `npm run dev` (http://localhost:2311).
# CLAUDE_RABBIT_SITE_URL=https://clauderabbit.in

# Longest time a fresh (uncached) scan streams before the client gives up, in ms.
# CLAUDE_RABBIT_SCAN_TIMEOUT_MS=150000
