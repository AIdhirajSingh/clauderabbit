{
  "name": "claude-rabbit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "ClaudeRabbit: paste a public GitHub repo or npm package and get a 0-100 safety score. Every scan installs and runs the code in a throwaway E2B sandbox behind a forge that answers every outbound call.",
  "scripts": {
    "dev": "next dev -p 2311",
    "build": "next build",
    "vercel-build": "node sandbox/e2b/build.ts --vercel-hook && node sandbox/e2b/delete-retired-templates.ts && next build",
    "start": "next start -p 2311",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/resolve-ts.mjs --test \"tests/**/*.test.ts\" \"app/**/*.test.ts\" \"components/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "test:python": "python3 -m unittest sandbox/e2b/guest/test_forge_core.py sandbox/e2b/guest/test_trace_fold.py",
    "template:build": "node sandbox/e2b/build.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/oidc": "3.2.0",
    "ai": "7.0.128",
    "e2b": "2.56.0",
    "next": "^16.2.9",
    "openai": "7.34.0",
    "postgres": "3.4.7",
    "puppeteer-core": "^25.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "semver": "6.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "critters": "^0.0.23",
    "d3-geo": "^3.1.1",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
