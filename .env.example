# ClaudeRabbit 2.0 environment. Names only; never commit a real value.
# Set server values as Vercel Project Environment Variables (Preview and Production).
# Only NEXT_PUBLIC_* values reach the browser. Full table: docs/2.0/DESIGN.md section 9.

# --- Public (client + server) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:2311
# AdSense (optional). Without both IDs the web shows the house ad. Test mode stays on unless set to off.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT_ID=0000000000
# NEXT_PUBLIC_ADSENSE_TEST=on

# --- Server only (Vercel) ---
# The two keys of key day:
# OPENAI_API_KEY=
# E2B_API_KEY=
# Supabase secret key for writes (sb_secret_...); SUPABASE_SERVICE_ROLE_KEY is read as a fallback.
# SUPABASE_SECRET_KEY=
# Optional overrides (defaults in lib/engine/config.ts):
# CR_MODEL_ID=gpt-6-luna
# CR_MODEL_REASONING_EFFORT=low
# CR_E2B_TEMPLATE=clauderabbit-detonate
# GITHUB_TOKEN=
# CR_OPERATOR_KEY=            (at least 32 chars; enables x-cr-operator-key regenerate)
# CR_DAILY_SANDBOX_SECONDS_CAP=20000
# CR_DAILY_MODEL_TOKENS_CAP=20000000
